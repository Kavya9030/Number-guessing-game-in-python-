def number_guessing_game():
    # Define game boundaries and attempts
    lower_bound = 1
    upper_bound = 100
    secret_number = random.randint(lower_bound, upper_bound)
    attempts = 0

    print("====================================")
    print("      🎯 NUMBER GUESSING GAME 🎯     ")
    print("====================================")
    print(f"I am thinking of a number between {lower_bound} and {upper_bound}.")

    # Game loop runs indefinitely until the user guesses correctly
    while True:
        try:
            # Get user input and convert it to an integer
            user_input = input("\nEnter your guess: ")
            guess = int(user_input)
            attempts += 1

            # Check the user's guess against the secret number
            if guess < secret_number:
                print("Too low! 📉 Try a higher number.")
            elif guess > secret_number:
                print("Too high! 📈 Try a lower number.")
            else:
                print(f"\n🎉 CONGRATULATIONS! You got it!")
                print(f"The secret number was indeed {secret_number}.")
                print(f"It took you {attempts} attempts to win.")
                break  # Exit the loop and end the game

        except ValueError:
            # Handle non-integer inputs without crashing
            print("❌ Invalid input! Please enter a valid whole number.")


# Run the game
if __name__ == "__main__":
    number_guessing_game()
